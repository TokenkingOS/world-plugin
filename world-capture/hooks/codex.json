{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run.sh\" codex SessionStart",
            "commandWindows": "& \"${PLUGIN_ROOT}/bin/capture-windows-$(if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }).exe\" codex SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run.sh\" codex Stop",
            "commandWindows": "& \"${PLUGIN_ROOT}/bin/capture-windows-$(if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }).exe\" codex Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run.sh\" codex SessionEnd",
            "commandWindows": "& \"${PLUGIN_ROOT}/bin/capture-windows-$(if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }).exe\" codex SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
